{
  "name": "airthere",
  "compatibility_date": "2026-09-15",
  "pages_build_output_dir": ".",
  "vars": {
    "CANONICAL_HOST": "airthere.com.au"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "airthere",
      "database_id": "4f80e221-9f3d-46b4-9493-dfd9bec8bcae"
    }
  ],
  // Application code always uses env.IMAGES. Production and Preview attach
  // different private buckets. preview_bucket_name is for wrangler pages dev
  // so local work cannot write to the production archive.
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "airthere-images",
      "preview_bucket_name": "airthere-images-preview"
    }
  ],
  "images": {
    "binding": "TRANSFORM"
  },
  "env": {
    "preview": {
      "vars": {
        "CANONICAL_HOST": "airthere.com.au",
        "PREVIEW_LOCKDOWN": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "airthere-preview",
          "database_id": "faa4d482-cadd-4f1d-8bbb-1a3d067c5d53"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "airthere-images-preview"
        }
      ],
      "images": {
        "binding": "TRANSFORM"
      }
    }
  }
}
